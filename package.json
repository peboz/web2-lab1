{
  "name": "web2-lab1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-files",
    "clean": "shx rm -rf dist",
    "copy-files": "shx cp -r src/views dist",
    "start": "node dist/main.js",
    "db:init": "npm run build && node dist/db-init.js",
    "db:seed": "npm run build && node dist/db-seed.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "express-openid-connect": "^3.4.0",
    "pg": "^8.16.3",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "shx": "^0.4.0",
    "typescript": "^5.9.0"
  }
}
