doctype html
html(lang="hr")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
  body
    h1= title
    p Status: #{pass.status}
    p Ime i prezime: #{pass.name}
    p Dokument: #{pass.document}
    p Vrijeme izdavanja: #{issuedAt}
    p
      a(href="/") Natrag
